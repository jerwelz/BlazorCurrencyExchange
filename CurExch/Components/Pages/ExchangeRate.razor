@page "/exchangerates"
@rendermode InteractiveServer
@using System.Text.Json
@using CurExch.Models
@inject IHttpClientFactory ClientFactory

<PageTitle>Exchange Rates</PageTitle>

<div class="exchange-page">
	<header class="exchange-header">
		<div>
			<p class="exchange-eyebrow">Exchange rates</p>
			<h1>@string.Concat("EUR / ", selectedCurrency)</h1>
		</div>
		<p class="exchange-header__meta">@($"Last {selectedDays} days")</p>
	</header>

	<section class="exchange-filters" aria-label="Exchange rate filters">
		<label>
			<span>Currency</span>
			<select @bind="selectedCurrency" @bind:after="ReloadRates">
				@foreach (var currency in currencies)
				{
					<option value="@currency">@currency</option>
				}
			</select>
		</label>
		<label>
			<span>Time range</span>
			<select @bind="selectedDays" @bind:after="ReloadRates">
				<option value="7">7 days</option>
				<option value="30">30 days</option>
				<option value="90">90 days</option>
				<option value="365">1 year</option>
			</select>
		</label>
	</section>

	<section class="exchange-results">
		@if (exchangeRates is null)
		{
			<div class="exchange-state">
				<p>Loading exchange rates...</p>
			</div>
		}
		else if (!exchangeRates.Any())
		{
			<div class="exchange-state">
				<p>No data is available for this selection.</p>
			</div>
		}
		else
		{
			<p class="exchange-results__count">@($"{exchangeRates.Count} records")</p>
			<table class="exchange-table">
				<thead>
					<tr><th>Date</th><th>Pair</th><th>Rate</th></tr>
				</thead>
				<tbody>
					@foreach (var rate in exchangeRates)
					{
						<tr><td>@rate.Date</td><td>@rate.Base / @rate.Quote</td><td>@rate.Rate</td></tr>
					}
				</tbody>
			</table>
		}
	</section>
</div>

@code {
	private readonly string[] currencies = ["USD", "GBP", "JPY", "CHF"];
	private List<CurrencyExchange>? exchangeRates;
	private int selectedDays = 30;
	private string selectedCurrency = "USD";

	protected override async Task OnInitializedAsync()
	{
		exchangeRates = await LoadRates(selectedDays, selectedCurrency);
	}

	private async Task ReloadRates()
	{
		exchangeRates = await LoadRates(selectedDays, selectedCurrency);
	}

	private async Task<List<CurrencyExchange>> LoadRates(int days, string currency)
	{
		var client = ClientFactory.CreateClient("FrankfurterClient");
		string fromDate = DateTime.Today.AddDays(-days).ToString("yyyy-MM-dd");

		using HttpResponseMessage response = await client.GetAsync(
			$"https://api.frankfurter.dev/v2/rates?base=EUR&quotes={currency}&from={fromDate}");

		response.EnsureSuccessStatusCode();

		string responseBody = await response.Content.ReadAsStringAsync();
		return JsonSerializer.Deserialize<List<CurrencyExchange>>(responseBody) ?? [];
	}
}
